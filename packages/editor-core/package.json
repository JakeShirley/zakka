{
  "name": "@zakka/editor-core",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stickers": {
      "types": "./dist/stickers.d.ts",
      "import": "./dist/stickers.js",
      "default": "./dist/stickers.js"
    },
    "./map-data": {
      "types": "./dist/map-data.d.ts",
      "import": "./dist/map-data.js",
      "default": "./dist/map-data.js"
    },
    "./map-data-detailed": {
      "types": "./dist/map-data-detailed.d.ts",
      "import": "./dist/map-data-detailed.js",
      "default": "./dist/map-data-detailed.js"
    },
    "./map-places": {
      "types": "./dist/map-places.d.ts",
      "import": "./dist/map-places.js",
      "default": "./dist/map-places.js"
    },
    "./font-licenses.txt": "./dist/font-licenses.txt",
    "./backgrounds/*": "./dist/backgrounds/*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "generate": "node scripts/generate-fonts.mjs && node scripts/generate-map-data.mjs && node scripts/generate-backgrounds.mjs",
    "generate:fonts": "node scripts/generate-fonts.mjs",
    "generate:maps": "node scripts/generate-map-data.mjs",
    "test": "pnpm run generate && vitest run src",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "vendor:maps": "node scripts/vendor-map-data.mjs"
  },
  "dependencies": {
    "@iconify-json/noto": "^1.2.7",
    "@iconify-json/twemoji": "^1.2.5",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.3",
    "d3-geo": "^3.1.2",
    "marked": "^18.0.4",
    "opentype.js": "^2.0.0",
    "topojson-client": "^3.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/opentype.js": "^1.3.9",
    "@types/topojson-client": "^3.1.5",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3"
  }
}
